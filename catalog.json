    {
      "id": "node18",
      "name": "Node.js 18",
      "category": "node",
      "desc": "Node.js v18 LTS via nvm",
      "install": [
        "bash",
        "-lc",
        "source ~/.nvm/nvm.sh && nvm install 18"
      ],
      "uninstall": [
        "bash",
        "-lc",
        "source ~/.nvm/nvm.sh && nvm uninstall 18"
      ],
      "detect": {
        "type": "dir",
        "path": "~/.nvm/versions/node/v18"
      }
    },
