      "id": "go1.22",
      "name": "Go 1.22",
      "category": "go",
      "desc": "Go SDK 1.22",
      "install": [
        "bash",
        "-lc",
        "curl -sSL https://go.dev/dl/go1.22.linux-amd64.tar.gz | tar -C /usr/local/go -xzf - && mv /usr/local/go/go /usr/local/go/go1.22"
      ],
      "uninstall": [
        "rm",
        "-rf",
        "/usr/local/go/go1.22"
      ],
      "detect": {
        "type": "dir",
        "path": "/usr/local/go/go1.22"
      }
    },
