      "category": "php",
      "desc": "PHP-FPM 7.4 (legacy)",
      "install": [
        "apt-get",
        "install",
        "-y",
        "php7.4-fpm"
      ],
      "uninstall": [
        "apt-get",
        "remove",
        "-y",
        "php7.4-fpm"
      ],
      "detect": {
        "type": "which",
