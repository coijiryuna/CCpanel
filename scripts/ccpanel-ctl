#!/usr/bin/env bash
# CCPanel service control: start/stop/restart/status.
#
# Jalankan sebagai root (akses nginx systemctl + mysql socket).
#   ./scripts/ccpanel-ctl start     # mulai uvicorn (background, log ke data/ccpanel.log)
#   ./scripts/ccpanel-ctl stop      # hentikan
#   ./scripts/ccpanel-ctl restart   # stop + start
#   ./scripts/ccpanel-ctl status    # cek PID + health (GET /api/dashboard 200?)
#
# Env diteruskan dari environment pemanggil (PANEL_PASSWORD, PANEL_JWT_SECRET,
# CCPANEL_* override). Kalau pakai systemd, abaikan script ini — pakai
# ccpanel.service (lihat README).
set -euo pipefail

APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PIDFILE="${CCPANEL_PIDFILE:-$APP_DIR/data/ccpanel.pid}"
LOGFILE="${CCPANEL_LOGFILE:-$APP_DIR/data/ccpanel.log}"
HOST="${CCPANEL_HOST:-127.0.0.1}"
PORT="${CCPANEL_PORT:-8888}"

mkdir -p "$APP_DIR/data"

pid() {
  [[ -f "$PIDFILE" ]] && cat "$PIDFILE" || true
}

is_running() {
  local p
  p="$(pid)"
  [[ -n "$p" ]] && kill -0 "$p" 2>/dev/null
}

do_start() {
  if is_running; then
    echo "Sudah jalan (pid $(pid))."
    return 0
  fi
  echo "Mulai CCPanel di $HOST:$PORT (log: $LOGFILE)"
  cd "$APP_DIR"
  nohup .venv/bin/uvicorn server:app --host "$HOST" --port "$PORT" \
    >>"$LOGFILE" 2>&1 &
  echo $! > "$PIDFILE"
  # tunggu health check maks 15 detik
  # login palsu → 401 tetap = server hidup; 000 (no response) = belum siap
  for _ in $(seq 1 15); do
    code=$(curl -s -m 2 -o /dev/null -w '%{http_code}' "http://$HOST:$PORT/api/login" \
      -X POST -H 'Content-Type: application/json' \
      -d '{"username":"__healthcheck__","password":"x"}' 2>/dev/null || true)
    if [[ "$code" != "000" && -n "$code" ]]; then
      echo "OK — panel merespons (HTTP $code)."
      return 0
    fi
    sleep 1
  done
  echo "Peringatan: panel belum merespons dalam 15 detik. Cek $LOGFILE."
  return 1
}

do_stop() {
  local p
  p="$(pid)"
  if [[ -z "$p" ]] || ! kill -0 "$p" 2>/dev/null; then
    echo "Tidak ada proses berjalan."
    rm -f "$PIDFILE"
    return 0
  fi
  echo "Hentikan CCPanel (pid $p)"
  kill "$p"
  for _ in $(seq 1 10); do
    kill -0 "$p" 2>/dev/null || break
    sleep 1
  done
  if kill -0 "$p" 2>/dev/null; then
    echo "Paksa kill (tidak berhenti dalam 10 detik)"
    kill -9 "$p"
  fi
  rm -f "$PIDFILE"
}

do_status() {
  local p
  p="$(pid)"
  if is_running; then
    code=$(curl -s -m 3 -o /dev/null -w '%{http_code}' "http://$HOST:$PORT/api/login" \
      -X POST -H 'Content-Type: application/json' \
      -d '{"username":"__healthcheck__","password":"x"}' 2>/dev/null || true)
    echo "CCPanel: RUNNING (pid $p, $HOST:$PORT, health HTTP $code)"
  else
    echo "CCPanel: STOPPED"
    [[ -f "$PIDFILE" ]] && echo "(pidfile basi: $p)"
  fi
}

case "${1:-}" in
  start)   do_start ;;
  stop)    do_stop ;;
  restart) do_stop; do_start ;;
  status)  do_status ;;
  *) echo "Pemakaian: $0 {start|stop|restart|status}"; exit 1 ;;
esac
